{
  "slug": "pacman-graph",
  "name": "Pac-Man Graph",
  "kind": "action",
  "difficulty": "Intermediate",
  "blurb": "The louder cousin. Ghosts included.",
  "asset": "assets/gamified/pacman-graph.svg",
  "picture": false,
  "tags": [
    "gamified",
    "pacman",
    "contributions",
    "action"
  ],
  "services": [
    {
      "host": "raw.githubusercontent.com",
      "optional": false
    }
  ],
  "placeholders": [
    {
      "token": "username",
      "where": "markdown",
      "description": "GitHub username (also profile repo name)",
      "example": "janedoe"
    },
    {
      "token": "name",
      "where": "markdown",
      "description": "Display name",
      "example": "Jane Doe"
    },
    {
      "token": "tagline",
      "where": "markdown",
      "description": "One-liner",
      "example": "arcade-grade frontend"
    },
    {
      "token": "commit_count",
      "where": "markdown",
      "description": "Optional flair — your commit total this year",
      "example": "1842"
    },
    {
      "token": "streak_days",
      "where": "markdown",
      "description": "Optional — current contribution streak",
      "example": "47"
    },
    {
      "token": "current_stage",
      "where": "markdown",
      "description": "Optional — what you're working on, framed as game",
      "example": "senior eng @ acme"
    },
    {
      "token": "currently_paragraph",
      "where": "markdown",
      "description": "1–2 sentences",
      "example": "Building..."
    },
    {
      "token": "website",
      "where": "markdown",
      "description": "Domain only",
      "example": "jane.dev"
    },
    {
      "token": "website_url",
      "where": "markdown",
      "description": "Full URL",
      "example": "https://jane.dev"
    },
    {
      "token": "twitter",
      "where": "markdown",
      "description": "Twitter handle without @",
      "example": "janedoe"
    }
  ],
  "credits": [
    {
      "name": "pacman-contribution-graph",
      "author": "abozanona",
      "url": "https://github.com/abozanona/pacman-contribution-graph",
      "license": "MIT"
    },
    {
      "name": "ghaction-github-pages",
      "author": "crazy-max",
      "url": "https://github.com/crazy-max/ghaction-github-pages",
      "license": "MIT"
    }
  ]
}
