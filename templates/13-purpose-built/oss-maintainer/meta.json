{
  "slug": "oss-maintainer",
  "name": "OSS Maintainer",
  "kind": "svg",
  "difficulty": "Basic",
  "blurb": "What you maintain, how fast you answer, where to start.",
  "asset": "assets/purpose-built/oss-maintainer.svg",
  "picture": false,
  "tags": [
    "open-source",
    "maintainer",
    "expectations",
    "utility",
    "self-hosted"
  ],
  "services": [],
  "placeholders": [
    {
      "token": "name",
      "where": "markdown",
      "description": "Display name — also set on the card",
      "example": "Jane Doe"
    },
    {
      "token": "repo_*",
      "where": "asset",
      "description": "The three project rows and their figures",
      "example": "acme-design-system · 1,243"
    },
    {
      "token": "commitment_*",
      "where": "asset",
      "description": "First response, triage day, review, security",
      "example": "within 72h"
    },
    {
      "token": "contributing_paragraph",
      "where": "markdown",
      "description": "How you want people to approach the projects",
      "example": "Open an issue before a large PR."
    },
    {
      "token": "good_first_url",
      "where": "markdown",
      "description": "Link to your good-first-issue filter",
      "example": "https://github.com/jane/acme/labels/good%20first%20issue"
    },
    {
      "token": "contributing_url",
      "where": "markdown",
      "description": "Link to your contributing guide",
      "example": "https://github.com/jane/acme/blob/main/CONTRIBUTING.md"
    },
    {
      "token": "project_*_name",
      "where": "markdown",
      "description": "Project name, one per bullet",
      "example": "acme design system"
    },
    {
      "token": "project_*_desc",
      "where": "markdown",
      "description": "One line on what it is",
      "example": "tokens shipped to 14 teams"
    },
    {
      "token": "website",
      "where": "markdown",
      "description": "Domain shown to the reader",
      "example": "jane.dev"
    },
    {
      "token": "website_url",
      "where": "markdown",
      "description": "Site URL with protocol",
      "example": "https://jane.dev"
    },
    {
      "token": "twitter",
      "where": "markdown",
      "description": "Twitter/X handle, no @",
      "example": "janedoe"
    }
  ],
  "credits": []
}
